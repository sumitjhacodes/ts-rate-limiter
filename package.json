{
  "name": "ts-rate-limiter",
  "version": "1.0.0",
  "description": "Production-ready rate limiting for Node.js applications",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "tsx benchmarks/index.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.4.1",
  "dependencies": {
    "fastify": "^5.12.4"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "tinybench": "^6.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^1.0.0"
  }
}