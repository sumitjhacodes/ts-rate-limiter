{
  "name": "ts-rate-limiter",
  "version": "0.1.0",
  "description": "Rate limiting for Node.js applications",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.4.1",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  }
}
